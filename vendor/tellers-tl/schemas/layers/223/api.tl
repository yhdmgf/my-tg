// @see https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot
// @see https://core.telegram.org/widgets/login#receiving-authorization-data
// @see https://core.telegram.org/widgets/login#setting-up-a-bot
// @see https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots
inputKeyboardButtonUrlAuth#68013e72 flags:# request_write_access:flags.0?true style:flags.10?KeyboardButtonStyle text:string fwd_text:flags.1?string url:string bot:InputUser = KeyboardButton;
